# Xero MCP connector credentials (Custom Connection — machine-to-machine OAuth2)
# Create a Custom Connection app at https://developer.xero.com/app/manage
# Set these as environment variables on your claude.ai/code environment — do NOT
# paste real values into chat or commit them to the repo.

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# Optional: override the scopes requested. The repo default (in .mcp.json) is
# read-only, per the project rule that nothing is ever posted to Xero.
# XERO_SCOPES=accounting.reports.read accounting.transactions.read accounting.contacts.read accounting.settings.read payroll.employees.read payroll.settings.read
